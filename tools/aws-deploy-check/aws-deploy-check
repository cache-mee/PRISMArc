#!/bin/sh
# @author Samson Paul, samson.paul@experionglobal.com
# Launcher for aws-deploy-check. Finds a Python 3 by whatever name this machine calls it.
DIR="$(cd "$(dirname "$0")" && pwd)"
TOOL="$DIR/aws-deploy-check.py"

for c in python3 python py python3.13 python3.12 python3.11 python3.10 python3.9 python3.8; do
  command -v "$c" >/dev/null 2>&1 || continue
  if "$c" -c 'import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)' 2>/dev/null; then
    exec "$c" "$TOOL" "$@"
  fi
done

echo "aws-deploy-check: no Python 3 found." >&2
echo "  tried: python3, python, py, python3.13 ... python3.8" >&2
echo "  install Python 3 (https://python.org), or set one explicitly:" >&2
echo "    /path/to/python3 $TOOL $*" >&2
exit 127
