APP_NAME=salon-app-backend
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/salon_app

# AWS Bedrock — calls go directly through boto3's bedrock-runtime Converse API
# (app.agent.providers.bedrock_provider), not through a bearer-token/API-key
# provider. Leave the AWS_* credential vars out entirely if you use SSO, a
# shared profile, or an IAM role instead — boto3's own default credential
# provider chain resolves them; this app never reads or handles them itself.
# AWS_REGION (not AWS_REGION_NAME) is boto3's own native env var name.
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Bedrock modelId or cross-region inference-profile id. Most current models
# are only callable through an inference profile (the "global."/"us."/"apac."
# prefixed ids), not the bare foundation-model id — use `aws bedrock
# list-foundation-models`/`list-inference-profiles` to find valid ids for
# your account/region if the default below isn't available to you.
# Verified working in ap-south-1 on this account:
#   global.amazon.nova-2-lite-v1:0
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.7
BEDROCK_TOP_P=0.9

# Windows-only: the installed uvicorn's asyncio loop factory hardcodes
# ProactorEventLoop on win32, which psycopg's async driver cannot run on
# ("psycopg.InterfaceError: Psycopg cannot use the 'ProactorEventLoop'").
# Run `python run_dev_server.py` instead of `uvicorn app.main:app` directly
# on Windows dev machines; not needed in the Docker image (Linux).
