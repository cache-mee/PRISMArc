# Shared RDS Postgres instance connection details.
# Copy this file to .env and fill in the team's actual RDS endpoint/credentials.
# Never commit .env — it is git-ignored.
RDS_HOST=rds-endpoint.example.internal
RDS_PORT=5432
RDS_USER=changeme
RDS_PASSWORD=changeme
RDS_DB=salon_app

# Backend
APP_ENV=development
DEBUG=true

# LLM provider credentials live in B2B_BE/.env (loaded via docker-compose.yml's
# env_file:), not here — see B2B_BE/.env.example.

# Host-side port mapping
BACKEND_PORT=8000
